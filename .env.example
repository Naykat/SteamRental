# Токен Telegram-бота от @BotFather
BOT_TOKEN=
# Telegram ID админов через запятую (узнать: @userinfobot)
ADMIN_IDS=

# Автовыполнение заказа после выдачи аккаунта
AUTO_CONFIRM_DEAL=1
# Сверка оплаченных заказов через API, сек
DEALS_POLL_SECONDS=60
# ТЕСТ: любая аренда длится N минут с момента покупки. Для работы — 0
TEST_RENTAL_MINUTES=0
# Повтор смены пароля Steam, если после аренды она не прошла, мин
ROTATION_RETRY_MINUTES=10
# Длительность аренды, если не удалось определить из лота
DEFAULT_RENTAL_HOURS=1
# Бонусные минуты сверх оплаченного времени
BONUS_MINUTES=10
# Предупреждать покупателя за N минут до конца (0 — выкл)
WARN_BEFORE_MINUTES=10
# Антиспам для !код, сек
CODE_COOLDOWN_SECONDS=10

# Выставлять с премиумом (по умолчанию, меняется в боте)
PUBLISH_PREMIUM=0
# Провайдер вывода Playerok для TRX-кошелька (TRC20). ID платёжного метода — если провайдер его требует
WITHDRAW_PROVIDER=USDT
WITHDRAW_PAYMENT_METHOD=
